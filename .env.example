# Copy to .env (git-ignored). Used by docker-compose and read by the backend as env vars.
DB_NAME=hercare
DB_USERNAME=hercare
DB_PASSWORD=change_me_locally
DB_PORT=5432
REDIS_PORT=6379

# Backend (Spring) - 32+ bytes. Generate: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_value_32_bytes_min
CORS_ALLOWED_ORIGINS=http://localhost:5173
